{
  "expo": {
    "name": "Memi",
    "slug": "memi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-memi.png",
      "resizeMode": "contain",
      "backgroundColor": "#06080f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.memi"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#06080f"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.memi"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Memi to capture photos for memes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Memi to pick photos for memes."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Memi to read your photos.",
          "savePhotosPermission": "Allow Memi to save memes."
        }
      ],
      "expo-sqlite",
      "@qvac/sdk/expo-plugin"
    ]
  }
}
